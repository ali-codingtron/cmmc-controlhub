# Dependencies — reinstalled inside the image
node_modules
**/node_modules

# Build output — produced inside the image
**/dist
**/.expo

# Git
.git
.gitignore

# Secrets and local config — never bake into the image
.env
.env.*
!.env.example

# Replit-specific files
.replit
replit.nix
.replitignore
.local/
.cache/
.agents/

# Development / generated assets not needed at runtime
attached_assets/
generated-assets/
generated-guides/
prisma/

# Logs and OS noise
*.log
npm-debug.log
yarn-error.log
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.sublime-workspace
