# ─────────────────────────────────────────────────────────────
#  CMMC Compliance Platform — Environment Variables
#  Copy this file to .env and fill in the values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────


# ── Application ───────────────────────────────────────────────

# Full public URL of the deployed app (no trailing slash)
APP_BASE_URL=https://your-domain.com

# Frontend base URL if served separately from the API (optional)
# Defaults to APP_BASE_URL when not set
FRONTEND_BASE_URL=

# Environment tag: "development" | "staging" | "production"
# APP_ENV takes precedence over NODE_ENV for app-level branching
APP_ENV=development
NODE_ENV=development

# Log level: "trace" | "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# Set to "false" to disable the public /demo route
ENABLE_PUBLIC_DEMO=true


# ── Database ──────────────────────────────────────────────────

# Full PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/cmmcdb


# ── Session & Security ────────────────────────────────────────

# Random secret used to sign Express sessions (min 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string

# AES-256 encryption key for TOTP MFA secrets stored in the DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=change-me-to-a-64-char-hex-string


# ── Object Storage (Replit / GCS) ─────────────────────────────

# Replit Object Storage bucket ID
DEFAULT_OBJECT_STORAGE_BUCKET_ID=replit-objstore-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path prefix for private (org-scoped) files inside the bucket
PRIVATE_OBJECT_DIR=/replit-objstore-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/.private

# Comma-separated path prefixes for publicly accessible files
PUBLIC_OBJECT_SEARCH_PATHS=/replit-objstore-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/public


# ── Email ─────────────────────────────────────────────────────

# Which email provider to use: "resend" | "smtp"
EMAIL_PROVIDER=resend

# Display name and address used in the From header
EMAIL_FROM=Control HUB <noreply@your-domain.com>

# ── Resend (used when EMAIL_PROVIDER=resend) ──────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── SMTP (used when EMAIL_PROVIDER=smtp) ─────────────────────
# Leave blank if using Resend
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# ── Microsoft Entra ID — User SSO Login ──────────────────────
# App registration used for signing users in via Microsoft SSO

MICROSOFT_SSO_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_SSO_CLIENT_SECRET=your-sso-client-secret
# Use /organizations for multi-tenant; replace with tenant ID for single-tenant
MICROSOFT_SSO_AUTHORITY=https://login.microsoftonline.com/organizations/v2.0
MICROSOFT_SSO_REDIRECT_URI=https://your-domain.com/api/auth/microsoft/callback

# Local dev override for the SSO redirect URI (optional)
# Avoids changing the production app registration during development
MICROSOFT_SSO_DEV_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback


# ── Microsoft Entra ID — Pre-Assessment (Graph API) ──────────
# Separate app registration used to scan the tenant via Microsoft Graph

MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=your-graph-client-secret
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/organizations
MICROSOFT_REDIRECT_URI=https://your-domain.com/api/pre-assessment/microsoft/callback

# Microsoft Graph permission scope (default is fine for most setups)
MICROSOFT_GRAPH_SCOPE=https://graph.microsoft.com/.default
